# Local synthetic demonstration only. Change credentials before sharing access.
POSTGRES_DB=afi_resolve
POSTGRES_USER=afi
POSTGRES_PASSWORD=afi-local-demo
OPERATOR_PASSWORD=operator-demo
REVIEWER_PASSWORD=reviewer-demo
RULES_ADMIN_PASSWORD=rules-admin-demo
AI_SERVICE_KEY=afi-internal-demo-key
GEMINI_API_KEY=
# Use a Gemini model available to your account. Empty key uses labelled fallback.
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_PORT=5173

# AWS override only: docker-compose.yml + docker-compose.aws.yml.
# Keep these secrets blank in this example. Set them privately on EC2.
# Use single-quoted .env values for passwords/keys containing $ or #.
RDS_HOST=afi-resolve-db.c3m460sie8eu.ap-southeast-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=afi_resolve
DB_USERNAME=
DB_PASSWORD=
RDS_CA_BUNDLE_PATH=./infrastructure/aws/certs/rds-ca-bundle.pem
AWS_REGION=ap-southeast-1
S3_BUCKET=afi-resolve-documents-uniqueid
S3_DOCUMENT_PREFIX=documents/
AWS_OPERATOR_PASSWORD=
AWS_REVIEWER_PASSWORD=
AWS_RULES_ADMIN_PASSWORD=
AWS_AI_SERVICE_KEY=
# Exact origin, no trailing slash: initially http://EC2_PUBLIC_IP, later https://your-domain.
AWS_FRONTEND_ORIGIN=
# For the synthetic demo only, opt in with AWS_DEMO_ENABLED=true and AWS_EXTRA_PROFILES=,demo.
AWS_DEMO_ENABLED=false
AWS_EXTRA_PROFILES=
# S3 uses the EC2 instance role. Do not add AWS access keys to this file.

